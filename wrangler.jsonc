{
  "name": "yosiart",
  "compatibility_date": "2026-09-07",
  // Necesario para que Express, pg y el resto de la API funcionen acá.
  "compatibility_flags": ["nodejs_compat"],
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // /api/... siempre va a la API, nunca a la página de la tienda.
    "run_worker_first": ["/api/*"]
  },
  // Datos que no son secretos. Los secretos (DATABASE_URL, JWT_SECRET,
  // BREVO_API_KEY, MAIL_FROM_EMAIL, ADMIN_EMAIL) se cargan en el panel de
  // Cloudflare: Workers → yosiart → Settings → Variables and Secrets.
  "vars": {
    "SITIO_URL": "https://yosiart.castrodavid9872.workers.dev",
    "API_URL": "https://yosiart.castrodavid9872.workers.dev",
    "MAIL_FROM_NOMBRE": "YosiArt",
    "ORIGENES_PERMITIDOS": "http://localhost:5173"
  },
  // Sin tareas programadas: el ping a Render ya no hace falta. La lista
  // vacía borra el cron que había quedado configurado en Cloudflare.
  "triggers": { "crons": [] },
  "observability": { "enabled": true }
}
