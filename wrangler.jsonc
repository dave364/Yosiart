{
  "name": "yosiart",
  "compatibility_date": "2026-09-07",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  // Cada 10 minutos despierta la API (ver worker/index.js)
  "triggers": {
    "crons": ["*/10 * * * *"]
  }
}
